generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CareRole {
  ADMIN
  CAREGIVER
  OBSERVER
}

enum LogType {
  MEAL
  MOOD
  SLEEP
  SYMPTOM
  BEHAVIOR
  INCIDENT
  NOTE
}

enum ActivityType {
  MEDICATION_CREATED
  MEDICATION_UPDATED
  MEDICATION_DELETED
  MEDICATION_ADMINISTERED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_COMPLETED
  EVENT_DELETED
  NOTE_CREATED
  NOTE_UPDATED
  NOTE_DELETED
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_FOLDER_CREATED
  DOCUMENT_FOLDER_UPDATED
  DOCUMENT_FOLDER_DELETED
  PATIENT_UPDATED
  CARE_CIRCLE_CREATED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  MEMBER_ROLE_UPDATED
  MEMBER_REMOVED
  INVITATION_REVOKED
  MEMBER_LEFT
}

enum NotificationType {
  MEDICATION
  TASK
  EVENT
}

enum NotificationKind {
  REMINDER
  MISSED
}

enum MedicationScheduleType {
  DAILY_TIMES
  INTERVAL
}

model User {
  id                  String                     @id @default(cuid())
  name                String
  email               String                     @unique
  avatar              String?
  passwordHash        String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  sessions            Session[]
  memberships         CareCircleMember[]
  medications         MedicationAdministration[]
  assignedTasks       CareTask[]                 @relation("AssignedTasks")
  completedTasks      CareTask[]                 @relation("CompletedTasks")
  completedEvents     CalendarEvent[]            @relation("CompletedEvents")
  logs                DailyLog[]
  activities          Activity[]
  documents           Document[]
  invitationsSent     CareInvitation[]           @relation("SentInvitations")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id                       String    @id @default(cuid())
  tokenHash                String    @unique
  refreshVersion           Int       @default(0)
  previousRefreshVersion   Int?
  previousRefreshExpiresAt DateTime?
  userId                   String
  expiresAt                DateTime
  createdAt                DateTime  @default(now())
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model CareCircle {
  id              String             @id @default(cuid())
  name            String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  patient         Patient?
  members         CareCircleMember[]
  medications     Medication[]
  tasks           CareTask[]
  events          CalendarEvent[]
  logs            DailyLog[]
  documents       Document[]
  documentFolders DocumentFolder[]
  activities      Activity[]
  notifications   Notification[]
  invitations     CareInvitation[]
}

model CareInvitation {
  id           String     @id @default(cuid())
  careCircleId String
  invitedById  String
  email        String?
  name         String?
  role         CareRole   @default(CAREGIVER)
  token        String     @unique
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  careCircle   CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  invitedBy    User       @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([careCircleId, email])
  @@index([careCircleId, expiresAt])
  @@index([token])
}

model CareCircleMember {
  id           String     @id @default(cuid())
  userId       String
  careCircleId String
  role         CareRole   @default(CAREGIVER)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  careCircle   CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)

  @@unique([userId, careCircleId])
}

model Patient {
  id               String     @id @default(cuid())
  careCircleId     String     @unique
  name             String
  age              Int
  birthDate        DateTime?
  photo            String?
  medicalCondition String?
  importantNotes   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  careCircle       CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
}

model Medication {
  id              String                     @id @default(cuid())
  careCircleId    String
  name            String
  dose            String
  schedule        String
  scheduleType    MedicationScheduleType     @default(DAILY_TIMES)
  startDate       DateTime                   @default(now())
  endDate         DateTime?
  intervalHours   Int?
  dailyDoseCount  Int                        @default(1)
  reminderMinutes Int                        @default(15)
  frequency       String
  instructions    String?
  active          Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  careCircle      CareCircle                 @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  administrations MedicationAdministration[]
  times           MedicationSchedule[]
}

model MedicationSchedule {
  id           String     @id @default(cuid())
  medicationId String
  time         String
  createdAt    DateTime   @default(now())
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, time])
  @@index([medicationId])
}

model MedicationAdministration {
  id             String     @id @default(cuid())
  medicationId   String
  userId         String
  scheduledFor   DateTime
  administeredAt DateTime   @default(now())
  medication     Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledFor])
}

model CareTask {
  id              String     @id @default(cuid())
  careCircleId    String
  title           String
  description     String?
  scheduledTime   String?
  scheduledDate   DateTime?
  reminderMinutes Int        @default(15)
  completed       Boolean    @default(false)
  assignedToId    String?
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  careCircle      CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  assignedTo      User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy     User?      @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
}

model CalendarEvent {
  id              String     @id @default(cuid())
  careCircleId    String
  title           String
  date            DateTime
  time            String
  reminderMinutes Int        @default(15)
  location        String?
  notes           String?
  completed       Boolean    @default(false)
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  careCircle      CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  completedBy     User?      @relation("CompletedEvents", fields: [completedById], references: [id], onDelete: SetNull)
}

model DailyLog {
  id           String     @id @default(cuid())
  careCircleId String
  userId       String
  type         LogType    @default(NOTE)
  content      String
  occurredAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  careCircle   CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id           String          @id @default(cuid())
  careCircleId String
  uploadedById String
  folderId     String?
  title        String
  fileName     String
  filePath     String
  mimeType     String?
  size         Int?
  notes        String?
  createdAt    DateTime        @default(now())
  careCircle   CareCircle      @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([careCircleId, folderId])
}

model DocumentFolder {
  id           String           @id @default(cuid())
  careCircleId String
  parentId     String?
  name         String
  locationKey  String
  systemKey    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  careCircle   CareCircle       @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  parent       DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocumentFolder[] @relation("DocumentFolderTree")
  documents    Document[]

  @@unique([careCircleId, locationKey])
  @@unique([careCircleId, systemKey])
  @@index([careCircleId, parentId])
}

model Activity {
  id           String       @id @default(cuid())
  careCircleId String
  userId       String?
  type         ActivityType
  message      String
  createdAt    DateTime     @default(now())
  careCircle   CareCircle   @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id            String           @id @default(cuid())
  careCircleId  String
  userId        String
  type          NotificationType
  kind          NotificationKind @default(REMINDER)
  sourceId      String
  occurrenceKey String
  title         String
  message       String
  url           String
  occurrenceFor DateTime?
  scheduledFor  DateTime
  claimedAt     DateTime?
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  careCircle    CareCircle       @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceKey])
  @@index([scheduledFor, sentAt])
  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
